# Google PageSpeed Insights API key (free, 25k requests/day)
# https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PSI_API_KEY=

# Upstash Redis — used for 24h result cache and per-IP rate limiting (free tier)
# https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Your production URL — used for OG image URLs, robots.txt, sitemap
# Update this after deploying (then redeploy so the build picks it up)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# No AI configuration is needed. The optional AI analysis on the results page
# runs on a key the visitor supplies in their own browser — see the
# "Bring your own model" section of the README.
